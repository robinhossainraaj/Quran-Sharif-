<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash theme using androidx.core:core-splashscreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#033815</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.QuranSharif</item>
    </style>

    <!-- Base application theme -->
    <style name="Theme.QuranSharif" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
